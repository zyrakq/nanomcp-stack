# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, forwarding/.env.example, stub-mcp-upstream/.env.example, publish-gateway-url-discovery/.env.example, mcp-gateway-stdio/.env.example

COMPOSE_PROJECT_NAME=nanomcp

# Image (source-built; see app/images/nanomcp/Dockerfile)
IMAGE=localhost/nanomcp:0.1.0

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# Inbound token callers must present (inbound=token mode; seeded into the
# credential store at container start). Empty = inbound stays off.
NANOMCP_SEED_INBOUND_TOKEN=

TZ=UTC
# Host-side published port (relay; the container always listens on 7332).
NANOMCP_PORT=7332
# MCP URL the gateway seeds the stub upstream with (inside nanomcp-network).
# Set to empty to skip stub seeding.
NANOMCP_SEED_STUB_URL=http://stub-mcp-upstream:8080/mcp
# Host-published gateway port for /.well-known/oauth-* URL discovery.
# Set to the port the gateway is published on (NANOMCP_PORT) so the
# discovery metadata advertises the same URL. Must differ from the relay
# listen port 7332 (e.g. NANOMCP_PORT=7100, NANOMCP_PUBLIC_PORT=7100).
# Empty = extension inert (gateway keeps its default port 7331).
NANOMCP_PUBLIC_PORT=
# Built-in stdio helper upstream (mcp-gateway-stdio extension). 1 = the
# entrypoint seeds a stdio servers.json entry the gateway spawns inside its
# own container: the in-image mcp-stdio-echo helper (one echo tool,
# namespaced stdio-helper__echo). Empty = not seeded.
NANOMCP_STDIO_HELPER=1
# Generic stdio upstream seeding (mcp-gateway-stdio extension): a complete
# servers.json server object (transport "stdio"; command required, resolved
# inside the gateway container via the child's PATH; args/env optional) for
# real stdio upstreams — the runtime a command needs must be in the image.
# Empty = not seeded. Example:
# NANOMCP_SEED_STDIO_JSON={"id":"fetch","name":"Fetch","alias":"fetch","transport":"stdio","enabled":true,"command":"uvx","args":["mcp-server-fetch"]}
NANOMCP_SEED_STDIO_JSON=