# Built-in stdio helper upstream (mcp-gateway-stdio extension). 1 = the
# entrypoint seeds a stdio servers.json entry the gateway spawns inside its
# own container: the in-image mcp-stdio-echo helper (one echo tool,
# namespaced stdio-helper__echo). Empty = not seeded.
NANOMCP_STDIO_HELPER=1
# Generic stdio upstream seeding (mcp-gateway-stdio extension): a complete
# servers.json server object (transport "stdio"; command required, resolved
# inside the gateway container via the child's PATH; args/env optional) for
# real stdio upstreams — the runtime a command needs must be in the image.
# Empty = not seeded. Example:
# NANOMCP_SEED_STDIO_JSON={"id":"fetch","name":"Fetch","alias":"fetch","transport":"stdio","enabled":true,"command":"uvx","args":["mcp-server-fetch"]}
NANOMCP_SEED_STDIO_JSON=
