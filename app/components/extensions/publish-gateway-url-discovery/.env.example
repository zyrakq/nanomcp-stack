# Host-published gateway port for /.well-known/oauth-* URL discovery.
# Set to the port the gateway is published on (NANOMCP_PORT) so the
# discovery metadata advertises the same URL. Must differ from the relay
# listen port 7332 (e.g. NANOMCP_PORT=7100, NANOMCP_PUBLIC_PORT=7100).
# Empty = extension inert (gateway keeps its default port 7331).
NANOMCP_PUBLIC_PORT=
